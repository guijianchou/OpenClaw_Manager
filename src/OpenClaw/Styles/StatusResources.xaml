<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Top status and status bar resources -->
    <x:Double x:Key="StatusBarTextFontSize">12</x:Double>
    <x:Double x:Key="TopStatusLabelFontSize">10</x:Double>
    <x:Double x:Key="TopStatusValueFontSize">10</x:Double>
    <x:Int32 x:Key="TopStatusLabelCharacterSpacing">10</x:Int32>
    <x:Int32 x:Key="TopStatusValueCharacterSpacing">10</x:Int32>
    <x:Int32 x:Key="TopStatusHeartbeatCharacterSpacing">40</x:Int32>
    <x:Int32 x:Key="TopStatusWorkStateCharacterSpacing">16</x:Int32>
    <x:Double x:Key="TopStatusPillMinWidth">440</x:Double>
    <x:Double x:Key="TopStatusPillMaxWidth">780</x:Double>
    <Thickness x:Key="TopStatusPillPadding">12,5</Thickness>
    <x:Double x:Key="TopStatusPillColumnSpacing">10</x:Double>
    <Thickness x:Key="TopStatusModelSegmentMargin">6,0,0,0</Thickness>
    <x:Double x:Key="TopStatusModelSegmentMinWidth">190</x:Double>
    <Thickness x:Key="TopStatusAccessSegmentMargin">18,0,0,0</Thickness>
    <x:Double x:Key="TopStatusIndicatorSpacing">4</x:Double>
    <x:Double x:Key="CompactTopStatusPillMinWidth">0</x:Double>
    <Thickness x:Key="CompactTopStatusPillPadding">8,5</Thickness>
    <Thickness x:Key="CompactTopStatusPillMargin">0,0,8,0</Thickness>
    <x:Double x:Key="CompactTopStatusPillColumnSpacing">4</x:Double>
    <x:Double x:Key="CompactTopStatusModelSegmentMinWidth">0</x:Double>
    <Thickness x:Key="CompactTopStatusModelSegmentMargin">4,0,0,0</Thickness>
    <Thickness x:Key="CompactTopBarPadding">8,6</Thickness>

    <Style x:Key="StatusBarTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StatusBarTextFontSize}" />
    </Style>

    <Style x:Key="TopStatusLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TopStatusLabelFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TopStatusLabelCharacterSpacing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TopStatusValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TopStatusValueFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TopStatusValueCharacterSpacing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TopStatusModelValueTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TopStatusValueTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource StatusBarTextFontSize}" />
    </Style>
</ResourceDictionary>
